<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
      <div class="card shadow-lg border-0 mt-5">
        <div class="card-body p-4">
          <div class="text-center mb-4">
            <h2 class="fw-bold text-primary">Edit <%= resource_name.to_s.humanize %></h2>
            <p class="text-muted">Update your account information</p>
          </div>

          <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>

            <div class="field mb-3">
              <%= f.label :email, class: "form-label fw-semibold" %>
              <div class="input-group">
                <span class="input-group-text bg-light border-0">
                  <i class="bi bi-envelope text-muted"></i>
                </span>
                <%= f.email_field :email, class: "form-control border-start-0", autofocus: true, autocomplete: "email", placeholder: "Enter your email" %>
              </div>
            </div>

            <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
              <div class="alert alert-warning d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <div>
                  Currently waiting confirmation for: <strong><%= resource.unconfirmed_email %></strong>
                </div>
              </div>
            <% end %>

            <hr class="my-4">
            <h5 class="fw-semibold text-muted mb-3">Change Password</h5>

            <div class="field mb-3">
              <%= f.label :password, class: "form-label fw-semibold" %>
              <small class="text-muted d-block mb-2">(leave blank if you don't want to change it)</small>
              <% if @minimum_password_length %>
                <small class="text-muted d-block mb-2">
                  (<%= @minimum_password_length %> characters minimum)
                </small>
              <% end %>
              <div class="input-group">
                <span class="input-group-text bg-light border-0">
                  <i class="bi bi-lock text-muted"></i>
                </span>
                <%= f.password_field :password, class: "form-control border-start-0", autocomplete: "new-password", placeholder: "Enter new password" %>
              </div>
            </div>

            <div class="field mb-3">
              <%= f.label :password_confirmation, class: "form-label fw-semibold" %>
              <div class="input-group">
                <span class="input-group-text bg-light border-0">
                  <i class="bi bi-lock-fill text-muted"></i>
                </span>
                <%= f.password_field :password_confirmation, class: "form-control border-start-0", autocomplete: "new-password", placeholder: "Confirm new password" %>
              </div>
            </div>

            <hr class="my-4">
            <h5 class="fw-semibold text-muted mb-3">Confirm Changes</h5>

            <div class="field mb-4">
              <%= f.label :current_password, class: "form-label fw-semibold" %>
              <small class="text-muted d-block mb-2">(we need your current password to confirm your changes)</small>
              <div class="input-group">
                <span class="input-group-text bg-light border-0">
                  <i class="bi bi-shield-lock text-muted"></i>
                </span>
                <%= f.password_field :current_password, class: "form-control border-start-0", autocomplete: "current-password", placeholder: "Enter current password" %>
              </div>
            </div>

            <div class="actions mb-3">
              <%= f.submit "Update", class: "btn btn-primary btn-lg w-100 fw-semibold" %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Danger Zone -->
      <div class="card shadow border-danger mt-4">
        <div class="card-body p-4">
          <h3 class="fw-bold text-danger mb-3">Cancel my account</h3>
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-muted mb-0">Unhappy? We're sorry to see you go.</p>
            </div>
            <div>
              <%= button_to "Cancel my account", registration_path(resource_name), data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, method: :delete, class: "btn btn-outline-danger" %>
            </div>
          </div>
        </div>
      </div>

      <div class="text-center mt-3">
        <%= link_to "Back", :back, class: "text-muted text-decoration-none" %>
      </div>
    </div>
  </div>
</div>
