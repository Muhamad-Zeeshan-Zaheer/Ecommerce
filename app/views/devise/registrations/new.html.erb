<div class="container vh-100 d-flex align-items-center justify-content-center">
  <div class="row w-100">
    <div class="col-md-6 col-lg-5 mx-auto">
      <div class="card border-0 shadow-sm" style="border-radius: 1rem;">
        <div class="card-body p-4 p-md-5">
          <div class="text-center mb-4">
            <div class="mb-3">
              <div class="rounded-circle bg-primary d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                <i class="bi bi-person-plus text-white fs-2"></i>
              </div>
            </div>
            <h2 class="fw-bold mb-2">Sign up</h2>
            <p class="text-muted">Join us today and get started</p>
          </div>

          <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>

            <div class="field mb-3">
              <%= f.label :email, "Email address", class: "form-label fw-semibold" %>
              <div class="input-group">
                <span class="input-group-text" style="background: #f8f9fa; border: 1px solid #dee2e6; border-right: none;">
                  <i class="bi bi-envelope text-muted"></i>
                </span>
                <%= f.email_field :email, class: "form-control", autofocus: true, autocomplete: "email", placeholder: "Enter your email", style: "border-left: none;" %>
              </div>
            </div>

            <div class="field mb-3">
              <%= f.label :password, "Password", class: "form-label fw-semibold" %>
              <% if @minimum_password_length %>
                <small class="text-muted d-block mb-2">
                  (<%= @minimum_password_length %> characters minimum)
                </small>
              <% end %>
              <div class="input-group">
                <span class="input-group-text" style="background: #f8f9fa; border: 1px solid #dee2e6; border-right: none;">
                  <i class="bi bi-lock text-muted"></i>
                </span>
                <%= f.password_field :password, class: "form-control", autocomplete: "new-password", placeholder: "Enter your password", style: "border-left: none;" %>
              </div>
            </div>

            <div class="field mb-4">
              <%= f.label :password_confirmation, "Confirm password", class: "form-label fw-semibold" %>
              <div class="input-group">
                <span class="input-group-text" style="background: #f8f9fa; border: 1px solid #dee2e6; border-right: none;">
                  <i class="bi bi-lock-fill text-muted"></i>
                </span>
                <%= f.password_field :password_confirmation, class: "form-control", autocomplete: "new-password", placeholder: "Confirm your password", style: "border-left: none;" %>
              </div>
            </div>

            <div class="actions mb-3">
              <%= f.submit "Sign up", class: "btn btn-primary btn-lg w-100 fw-semibold", style: "border-radius: 0.5rem;" %>
            </div>
          <% end %>

          <div class="mt-4 pt-4 border-top">
            <div class="text-center">
              <small class="text-muted">
                Already have an account?
                <%= link_to "Log in", new_session_path(resource_name), class: "text-primary text-decoration-none fw-semibold" %>
              </small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .form-control:focus {
    border-color: #007bff;
    box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
  }

  .btn-primary:hover {
    background: #0056b3;
    border-color: #0056b3;
  }

  .input-group-text:focus {
    border-color: #007bff;
  }
</style>
