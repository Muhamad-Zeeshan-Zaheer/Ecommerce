<div class="container vh-100 d-flex align-items-center justify-content-center">
  <div class="row w-100">
    <div class="col-md-6 col-lg-5 mx-auto">
      <div class="card border-0 shadow-sm" style="border-radius: 1rem;">
        <div class="card-body p-4 p-md-5">
          <div class="text-center mb-4">
            <div class="mb-3">
              <div class="rounded-circle bg-primary d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                <i class="bi bi-person-circle text-white fs-2"></i>
              </div>
            </div>
            <h2 class="fw-bold mb-2">Log in</h2>
            <p class="text-muted">Sign in to your account to continue</p>
          </div>

          <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
            <div class="field mb-3">
              <%= f.label :email, "Email address", class: "form-label fw-semibold" %>
              <div class="input-group">
                <span class="input-group-text" style="background: #f8f9fa; border: 1px solid #dee2e6; border-right: none;">
                  <i class="bi bi-envelope text-muted"></i>
                </span>
                <%= f.email_field :email, class: "form-control", autofocus: true, autocomplete: "email", placeholder: "Enter your email", style: "border-left: none;" %>
              </div>
            </div>

            <div class="field mb-3">
              <%= f.label :password, "Password", class: "form-label fw-semibold" %>
              <div class="input-group">
                <span class="input-group-text" style="background: #f8f9fa; border: 1px solid #dee2e6; border-right: none;">
                  <i class="bi bi-lock text-muted"></i>
                </span>
                <%= f.password_field :password, class: "form-control", autocomplete: "current-password", placeholder: "Enter your password", style: "border-left: none;" %>
              </div>
            </div>

            <% if devise_mapping.rememberable? %>
              <div class="field mb-3">
                <div class="form-check">
                  <%= f.check_box :remember_me, class: "form-check-input" %>
                  <%= f.label :remember_me, "Remember me", class: "form-check-label" %>
                </div>
              </div>
            <% end %>

            <div class="actions mb-3">
              <%= f.submit "Log in", class: "btn btn-primary btn-lg w-100 fw-semibold", style: "border-radius: 0.5rem;" %>
            </div>

            <div class="text-center">
              <%= link_to "Forgot your password?", new_password_path(resource_name), class: "text-primary text-decoration-none" %>
            </div>
          <% end %>

          <div class="mt-4 pt-4 border-top">
            <div class="text-center">
              <small class="text-muted">
                Don't have an account?
                <%= link_to "Sign up", new_registration_path(resource_name), class: "text-primary text-decoration-none fw-semibold" %>
              </small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .form-control:focus {
    border-color: #007bff;
    box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
  }

  .btn-primary:hover {
    background: #0056b3;
    border-color: #0056b3;
  }

  .input-group-text:focus {
    border-color: #007bff;
  }
</style>
