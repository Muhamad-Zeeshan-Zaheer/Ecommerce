<div class="container-md py-4">
  <!-- Header Section -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
          <h1 class="h2 mb-2">Categories</h1>
          <p class="text-muted">Manage your product categories</p>
        </div>
        <div class="d-flex gap-2">
          <%= link_to "Add New Category", new_category_path, class: "btn btn-primary" %>
        </div>
      </div>
    </div>
  </div>

  <div class="row" id="categoriesGrid">
    <% @categories.each do |category| %>
      <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
        <div class="card h-100 product-card">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><%= category.name %></h5>

            <div class="d-flex gap-2 mt-auto justify-content-end">
              <%= link_to edit_category_path(category), class: "btn btn-primary btn-sm d-flex align-items-center gap-1" do %>
                <i class="bi bi-pencil-square"></i>
                <span>Edit</span>
              <% end %>
              <%= link_to category_path(category), data: {
                  turbo_method: :delete,
                  turbo_confirm: "Are you sure you want to delete this category?"
                }, class: "btn btn-danger btn-sm d-flex align-items-center gap-1" do %>
                <i class="bi bi-trash"></i>
                <span>Delete</span>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <% if @categories.empty? %>
    <div class="text-center py-5">
      <div class="text-muted">
        <i class="bi bi-folder" style="font-size: 4rem;"></i>
        <p class="mt-3">No categories yet. Create your first category!</p>
        <%= link_to "Add New Category", new_category_path, class: "btn btn-primary mt-2" %>
      </div>
    </div>
  <% end %>
</div>
