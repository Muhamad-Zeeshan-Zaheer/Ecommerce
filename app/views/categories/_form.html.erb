<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">

      <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white py-3 rounded-top-4">
          <h4 class="mb-0">
            <%= @category.new_record? ? "Add New Category" : "Edit Category" %>
          </h4>
        </div>

        <%= form_with model: @category do |form| %>

          <div class="card-body p-4">
            <div class="row g-4">

              <div class="col-12">
                <%= form.label :name, class: "form-label fw-semibold" %>
                <%= form.text_field :name,
                    class: "form-control form-control-lg",
                    placeholder: "Enter category name" %>
              </div>

            </div>
          </div>

          <div class="card-footer bg-light border-0 p-4 d-flex justify-content-between">
            <%= link_to "Cancel", categories_path, class: "btn btn-outline-secondary px-4" %>

            <%= form.submit @category.new_record? ? "Create Category" : "Update Category",
                class: "btn btn-primary px-5 fw-semibold" %>
          </div>

        <% end %>
      </div>

    </div>
  </div>
</div>
