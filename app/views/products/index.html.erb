<div class="container-md py-4">
  <!-- Header Section -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
          <h1 class="h2 mb-2">Products</h1>
          <p class="text-muted">Browse our products by categories</p>
        </div>
        <div class="d-flex gap-2">
          <%= link_to "Add New Product", new_product_path, class: "btn btn-primary" %>
        </div>
      </div>
    </div>
  </div>

  <div class="row" id="categoriesGrid">
    <% @categories.each do |category| %>
      <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
        <div class="card h-100 category-card">
          <!-- Category Image/Icon -->
          <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
            <div class="text-muted">
              <i class="bi bi-folder" style="font-size: 3rem;"></i>
              <p class="small mb-0 mt-2">Category</p>
            </div>
          </div>

          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><%= category.name %></h5>

            <p class="card-text text-muted flex-grow-1">
              Browse products in this category
            </p>

            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="badge bg-primary">
                <%= category.products.count %> Products
              </span>
            </div>

            <div class="d-flex gap-2 mt-auto">
              <%= link_to category_path(category), class: "btn btn-primary btn-sm flex-fill" do %>
                <i class="bi bi-eye"></i>
                <span>View Products</span>
              <% end %>
              <%= link_to edit_category_path(category), class: "btn btn-outline-secondary btn-sm" do %>
                <i class="bi bi-pencil"></i>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Empty State -->
  <% if @categories.empty? %>
    <div class="row">
      <div class="col-12">
        <div class="text-center py-5">
          <i class="bi bi-folder" style="font-size: 4rem; color: #6c757d;"></i>
          <h3 class="mt-3">No categories found</h3>
          <p class="text-muted">Start by creating your first category to organize your products.</p>
          <%= link_to "Create Your First Category", new_category_path, class: "btn btn-primary" %>
        </div>
      </div>
    </div>
  <% end %>
  <div class="d-flex justify-content-end mt-4">
    <%= will_paginate @categories , class: "apple_pagination" %>
  </div>
</div>
