<div class="container-md py-4">
  <!-- Header Section -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
          <h1 class="h2 mb-2">Our Products</h1>
          <p class="text-muted">Discover our amazing collection of products</p>
        </div>
        <div class="d-flex gap-2">
          <%= link_to "Add New Product", new_product_path, class: "btn btn-primary" %>
          <%= link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete }, class: "btn btn-outline-danger" %>
        </div>
      </div>
    </div>
  </div>


  <div class="row" id="productsGrid">
    <% @products.each do |product| %>
      <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
        <div class="card h-100 product-card">
          <!-- Placeholder for product image -->
          <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
            <div class="text-muted">
              <i class="bi bi-image" style="font-size: 3rem;"></i>
              <p class="small mb-0 mt-2">No Image</p>
            </div>
          </div>

          <div class="card-body d-flex flex-column">
            <div class="mb-2">
              <span class="badge bg-secondary text-white">SKU: <%= product.sku %></span>
            </div>

            <h5 class="card-title"><%= product.name %></h5>

            <p class="card-text text-muted flex-grow-1">
              <%= truncate(product.description, length: 80) %>
            </p>

            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="h4 text-primary mb-0">$<%= product.price %></span>
              <span class="badge <%= product.stock_quantity > 0 ? 'bg-success' : 'bg-danger' %>">
                <%= product.stock_quantity > 0 ? "#{product.stock_quantity} in stock" : 'Out of stock' %>
              </span>
            </div>

            <div class="d-flex gap-2 mt-auto justify-content-end">
              <%= link_to edit_product_path(product), class: "btn btn-primary btn-sm d-flex align-items-center gap-1" do %>
                <i class="bi bi-pencil-square"></i>
                <span>Edit</span>
              <% end %>
              <%= link_to product_path(product), data: {
                  turbo_method: :delete,
                  turbo_confirm: "Are you sure you want to delete this product?"
                }, class: "btn btn-danger btn-sm d-flex align-items-center gap-1" do %>
                <i class="bi bi-trash"></i>
                <span>Delete</span>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Empty State -->
  <% if @products.empty? %>
    <div class="row">
      <div class="col-12">
        <div class="text-center py-5">
          <i class="bi bi-box-seam" style="font-size: 4rem; color: #6c757d;"></i>
          <h3 class="mt-3">No products found</h3>
          <p class="text-muted">Start by adding your first product to the catalog.</p>
          <%= link_to "Add Your First Product", new_product_path, class: "btn btn-primary" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
